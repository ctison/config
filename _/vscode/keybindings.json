[
  // Open keybindings
  { "key": "cmd+k cmd+k", "command": "workbench.action.openGlobalKeybindingsFile" },
  // Remove default keybinds
  { "command": "-workbench.action.splitEditor", "key": "cmd+\\" },

  // Disable toggling suggestion details
  { "key": "ctrl+space", "command": "-toggleSuggestionDetails", "when": "suggestWidgetVisible" },
  {
    "key": "ctrl+shift+space",
    "command": "toggleSuggestionDetails",
    "when": "suggestWidgetVisible"
  },

  // Toggle terminal in right panel
  { "key": "cmd+shift+1", "command": "workbench.action.toggleAuxiliaryBar" },
  // Maximize editor group
  { "key": "cmd+shift+2", "command": "workbench.action.toggleEditorWidths" },

  // Toggle left panel
  { "key": "alt+cmd+;", "command": "workbench.action.toggleSidebarVisibility" },
  // Toggle right panel
  { "key": "alt+cmd+'", "command": "workbench.action.toggleAuxiliaryBar" },

  // Maximize bottom panel
  { "key": "shift+cmd+j", "command": "workbench.action.toggleMaximizedPanel" },

  // New file
  { "key": "cmd+n", "command": "explorer.newFile" },
  { "key": "alt+cmd+n", "command": "workbench.action.files.newUntitledFile" },

  // Toggle dev tools
  { "key": "alt+cmd+i", "command": "workbench.action.toggleDevTools" },

  // Toggle settings
  { "key": "cmd+,", "when": "inSettingsEditor", "command": "workbench.action.openSettingsJson" },
  { "key": "cmd+,", "when": "inSettingsJSONEditor", "command": "workbench.action.openSettings2" },

  // Open terminal in editor
  { "key": "shift+cmd+c", "command": "workbench.action.createTerminalEditor" },

  // Open chat in editor
  { "key": "cmd+shift+i", "command": "workbench.action.openChat" },
  // { "key": "ctrl+`", "command": "workbench.action.togglePanel" },

  // Show hover
  { "key": "alt+cmd+/", "command": "editor.action.showHover", "when": "editorTextFocus" },

  // Bun
  {
    "key": "cmd+r",
    "when": "debugType == bun",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.panel.repl.view.focus",
        "extension.bun.runFile",
        "workbench.action.focusActiveEditorGroup"
      ]
    }
  },

  // Rust
  {
    "key": "cmd+r",
    "when": "editorLangId == rust",
    "command": "runCommands",
    "args": { "commands": ["workbench.panel.repl.view.focus", "rust-analyzer.run"] }
  },
  { "command": "rust-analyzer.openDocs", "key": "alt+cmd+d", "when": "editorLangId == rust" },

  // Focus outline
  { "command": "outline.focus", "key": "alt+cmd+o" },

  // Resize terminal
  {
    "command": "workbench.action.terminal.resizePaneLeft",
    "when": "terminalFocus",
    "key": "ctrl+cmd+up"
  },
  {
    "key": "ctrl+cmd+down",
    "when": "terminalFocus",
    "command": "workbench.action.terminal.resizePaneRight"
  },

  // Toggle inlay hints
  {
    "key": "alt+cmd+y",
    "when": "editorTextFocus",
    "command": "settings.cycle",
    "args": {
      "id": "editor.inlayHints.enabled",
      "values": [
        { "editor.inlayHints.enabled": "offUnlessPressed" },
        { "editor.inlayHints.enabled": "onUnlessPressed" }
      ]
    }
  },

  // Toggle split direction
  {
    "key": "cmd+shift+0",
    "command": "settings.cycle",
    "args": {
      "id": "workbench.editor.openSideBySideDirection",
      "values": [
        { "workbench.editor.openSideBySideDirection": "right" },
        { "workbench.editor.openSideBySideDirection": "down" }
      ]
    }
  },

  // Fold & unfold recursively
  {
    "key": "alt+cmd+shift+[",
    "command": "editor.foldRecursively",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "alt+cmd+shift+]",
    "command": "editor.unfoldRecursively",
    "when": "editorTextFocus && foldingEnabled"
  },

  // Search references
  {
    "key": "shift+cmd+3",
    "when": "editorHasReferenceProvider && !inReferenceSearchEditor && !isInEmbeddedEditor",
    "command": "editor.action.referenceSearch.trigger"
  },

  // Show file context menu in explorer
  {
    "key": "d",
    "when": "filesExplorerFocus && !inputFocus",
    "command": "editor.action.showContextMenu"
  },
  {
    "key": "shift+alt+f",
    "command": "filesExplorer.findInFolder",
    "when": "explorerResourceIsFolder && filesExplorerFocus && foldersViewVisible && !inputFocus"
  },

  // Toggle notifications panel
  { "key": "shift+cmd+4", "when": "!notificationFocus", "command": "notifications.showList" },
  { "key": "shift+cmd+4", "when": "notificationFocus", "command": "notifications.hideList" },

  // Git
  { "key": "alt+cmd+,", "command": "git.openChange", "when": "!isInDiffEditor" },
  { "key": "alt+cmd+,", "command": "git.openFile", "when": "isInDiffEditor" },
  {
    "key": "alt+cmd+shift+,",
    "command": "settings.cycle",
    "args": {
      "id": "diffEditor.renderSideBySide",
      "values": [{ "diffEditor.renderSideBySide": true }, { "diffEditor.renderSideBySide": false }]
    }
  },
  {
    "key": "f1",
    "when": "editorTextFocus && editor.hasSelection",
    "command": "git.stageSelectedRanges"
  },
  {
    "key": "cmd+F1",
    "when": "editorTextFocus && editor.hasSelection",
    "command": "git.unstageSelectedRanges"
  },
  {
    "key": "f1",
    "when": "editorTextFocus && !editor.hasSelection && git.activeResourceHasUnstagedChanges",
    "command": "git.stage"
  },
  {
    "key": "f1",
    "when": "editorTextFocus && !git.activeResourceHasUnstagedChanges && git.activeResourceHasStagedChanges",
    "command": "git.unstage"
  },
  { "key": "f1", "when": "focusedView == workbench.scm", "command": "git.stageFile" },
  { "key": "cmd+F1", "when": "focusedView == workbench.scm", "command": "git.unstageFile" },
  { "key": "cmd+shift+F1", "command": "git.viewChanges" },

  // Join all editors
  { "key": "f18", "command": "workbench.action.joinAllGroups" },

  // Reload
  { "key": "shift+f19", "command": "workbench.action.restartExtensionHost" },
  {
    "key": "cmd+f19",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closeAllEditors",
        "workbench.files.action.collapseExplorerFolders"
      ]
    }
  },
  { "key": "cmd+shift+f19", "command": "workbench.action.reloadWindow" },

  // Terminal signals
  {
    "key": "ctrl+shift+t",
    "command": "workbench.action.terminal.sendSignal",
    "args": { "signal": "SIGTERM" },
    "when": "terminalFocus && terminalProcessSupported"
  },
  {
    "key": "ctrl+shift+k",
    "command": "workbench.action.terminal.sendSignal",
    "args": { "signal": "SIGKILL" },
    "when": "terminalFocus && terminalProcessSupported"
  }
]
