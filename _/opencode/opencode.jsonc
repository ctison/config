{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "dmr": {
      "options": {
        "baseURL": "http://127.0.0.1:12434/engines/v1",
        "timeout": 60000
      },
      "models": {
        "docker.io/ai/gemma4:E4B": {
          "name": "Gemma 4 E4B",
          "limit": { "context": 128000, "output": 0 }
        },
        "docker.io/ai/qwen3.6:35B-A3B-UD-Q4_K_M": {
          "name": "Qwen 3.6 35B-A3B 4-bit",
          "limit": { "context": 262144, "output": 262144 }
        }
      }
    },
    "mlx": {
      "options": { "baseURL": "http://127.0.0.1:7777", "timeout": 60000 },
      "models": {
        "mlx-community/Qwen3.6-35B-A3B-8bit": {
          "name": "Qwen 3.6 35B-A3B 8-bit",
          "limit": { "context": 262144, "output": 262144 }
        },
        "mlx-community/Qwen3.6-35B-A3B-4bit": {
          "name": "Qwen 3.6 35B-A3B 4-bit",
          "limit": { "context": 262144, "output": 262144 }
        }
      }
    }
  },
  "model": "mlx/mlx-community/Qwen3.6-35B-A3B-4bit",
  "autoupdate": false,
  "command": {}
}
