{
  "version": 2,
  "theme": "builtin://dracula",
  "check_for_updates": false,
  "editor": {
    "tab_size": 2,
    "animations": true,
    "scroll_offset": 15,
    "highlight_current_line": false,
    "diagnostics_inline_text": true,
    "trim_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "cursor_style": "blinking_bar",
    "completion_popup_auto_show": true,
    "quick_suggestions_delay_ms": 10,
    "show_menu_bar": false,
    "menu_bar_mnemonics": false,
    "show_tilde": true,
    "use_terminal_bg": false,
    "whitespace_spaces_trailing": true,
    "cursor_jump_animation": false
  },
  "file_explorer": {
    "respect_gitignore": false,
    "show_hidden": true,
    "show_gitignored": true,
    "follow_active_buffer": true
  },
  "file_browser": {
    "show_hidden": true
  },
  "active_keybinding_map": "macos-gui"
}
