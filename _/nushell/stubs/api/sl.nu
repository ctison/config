# SimpleLogin
# https://github.com/simple-login/app/blob/master/docs/api.md

const SL_URL = 'https://app.simplelogin.io'

# === HELPERS ===

def '_http get' [path: string, params?: record, ...rest] {
  fnox run sl {
    (http get --redirect-mode manual --full=(log is-debug)
      -H { Authentication: $env.SL_KEY }
      $'($SL_URL)($path)($params | url into query)'
    )
    | if (log is-debug) {
      log debug $in
      $in.body
    } else $in
  }
}

def '_http post' [path: string, params?: record, payload?: any] {
  fnox run sl {
    (http post --redirect-mode manual --full=(log is-debug)
      -H { Authentication: $env.SL_KEY }
      -t application/json
      $'($SL_URL)($path)($params | url into query)'
      ($payload | compact | to json -r)
    )
    | if (log is-debug) {
      log debug $in
      $in.body
    } else $in
  }
}

def '_http delete' [path: string, params?: record] {
  fnox run sl {
    (http delete --redirect-mode manual --full=(log is-debug)
      -H { Authentication: $env.SL_KEY }
      $'($SL_URL)($path)($params | url into query)'
    )
    | if (log is-debug) {
      log debug $in
      $in.body
    } else $in
  }
}

# === ACCOUNTS ENDPOINTS ===

# Get authenticated user information
export def user [] {
  _http get /api/user_info
}

# === ALIAS ENDPOINTS ===

# Get custom alias options
export def 'aliases options' [
  --hostname: string  # Custom domain hostname
] {
  _http get /api/v5/alias/options { hostname: $hostname }
}

# Create a custom alias
export def 'aliases create custom' [
  aliasPrefix: string   # Prefix for the alias (e.g., "shopping")
  signedSuffix: string  # Signed suffix generated by SimpleLogin
  mailboxIds: list<int> # IDs of mailboxes to assign the alias to
  --hostname: string    # Custom domain hostname
  --note: string        # Note/description for the alias
  --name: string        # User-facing name for the alias
] {
  _http post /api/v3/alias/custom/new { hostname: $hostname } {
    alias_prefix: $aliasPrefix
    signed_suffix: $signedSuffix
    mailbox_ids: $mailboxIds
    note: $note
    name: $name
  }
}

# Create a random alias
export def 'aliases create random' [
  --hostname: string # Custom domain hostname
  --mode: string     # Random generation mode [word, uuid]
  --note: string     # Note/description for the alias
] {
  _http post /api/alias/random/new { hostname: $hostname, mode: $mode } { note: $note }
}

# List aliases for a page with optional filtering
export def aliases [
  pageId = 0 # Page number
  --pinned   # Filter to pinned aliases only
  --disabled # Filter to disabled aliases only
  --enabled  # Filter to enabled aliases only
] {
  _http get /api/v2/aliases {
    page_id: $pageId
    pinned: $pinned
    disabled: $disabled
    enabled: $enabled
  }
}

# Get details for a specific alias
export def 'aliases get' [
  aliasId: int # ID of the alias
] {
  _http get /api/aliases/($aliasId)
}

# Delete an alias
export def 'aliases delete' [
  aliasId: int # ID of the alias to delete
] {
  _http delete /api/aliases/($aliasId)
}

# Toggle an alias (enable/disable)
export def 'aliases toggle' [
  aliasId: int # ID of the alias to toggle
] {
  _http post /api/aliases/($aliasId)/toggle
}

# Get activities/email logs for an alias
export def 'aliases activities' [
  aliasId: int # ID of the alias
  pageId: int  # Page number for pagination
] {
  _http get /api/aliases/($aliasId)/activities { page_id: $pageId }
}

# Get contacts associated with an alias
export def 'aliases contacts' [
  aliasId: int # ID of the alias
  pageId: int  # Page number for pagination
] {
  _http get /api/aliases/($aliasId)/contacts { page_id: $pageId }
}

# Create a contact for an alias
export def 'aliases contact create' [
  aliasId: int    # ID of the alias
  contact: string # Email address of the contact to add
] {
  { contact: $contact }
  | _http post /api/aliases/($aliasId)/contacts {} $in
}

# Update an alias's settings
export def 'aliases update' [
  aliasId: int             # ID of the alias to update
  --note: string           # Update the alias note
  --name: string           # Update the alias display name
  --mailbox-id: int        # Update assigned mailbox
  --mailbox-ids: list<int> # Update assigned mailboxes
  --disable-pgp            # Disable PGP encryption for this alias
  --pinned                 # Pin/unpin the alias
] {
  _http post /api/aliases/($aliasId) {} {
    note: $note
    name: $name
    mailbox_id: $mailbox_id
    mailbox_ids: $mailbox_ids
    disable_pgp: $disable_pgp
    pinned: $pinned
  }
}

# === MAILBOX ENDPOINTS ===

# List all mailboxes
export def mailboxes [] {
  _http get /api/v2/mailboxes
}

# Create a new mailbox
export def 'mailbox create' [
  email: string # Email address for the new mailbox
] {
  _http post /api/mailboxes {} { email: $email }
}

# Update a mailbox's settings
export def 'mailbox update' [
  mailboxId: int  # ID of the mailbox to update
  --default       # Set as default mailbox
  --email: string # Update the mailbox email address
  --cancel-change # Cancel pending email change
] {
  _http post /api/mailboxes/($mailboxId) {} {
    default: $default
    email: $email
    cancel_email_change: $cancel_change
  }
}

# === CUSTOM DOMAIN ENDPOINTS ===

# List all custom domains
export def domains [] {
  _http get /api/custom_domains
}

# Update a custom domain's settings
export def 'domain update' [
  customDomainId: int      # ID of the custom domain to update
  --catch-all              # Enable catch-all for this domain
  --random-prefix          # Enable random prefix generation
  --name: string           # Update domain name/label
  --mailbox-ids: list<int> # Update assigned mailboxes
] {
  _http post /api/custom_domains/($customDomainId) {} {
    catch_all: $catch_all
    random_prefix_generation: $random_prefix
    name: $name
    mailbox_ids: $mailbox_ids
  }
}

# Get trashed aliases for a custom domain
export def 'domain trash' [
  customDomainId: int # ID of the custom domain
] {
  _http get /api/custom_domains/($customDomainId)/trash
}

# === CONTACT ENDPOINTS ===

# Delete a contact
export def 'contact delete' [
  contactId: int # ID of the contact to delete
] {
  _http delete /api/contacts/($contactId)
}

# Toggle a contact (enable/disable)
export def 'contact toggle' [
  contactId: int # ID of the contact to toggle
] {
  _http post /api/contacts/($contactId)/toggle
}

# === NOTIFICATION ENDPOINTS ===

# List notifications with pagination
export def notifications [
  --page = 0 # Page to fetch
] {
  _http get /api/notifications { page: $page }
}

# Mark a notification as read
export def 'notification mark read' [
  notificationId: int # ID of the notification to mark as read
] {
  _http post /api/notifications/($notificationId)
}

# === SETTINGS ENDPOINTS ===

# Get user settings
export def settings [] {
  _http get /api/setting
}

# Update user settings
export def 'setting update' [
  --alias-generator: string # Alias generation method
  --notification            # Enable/disable email notifications
  --random-domain: string   # Default domain for random aliases
  --sender-format: string   # Sender name format
  --random-suffix: string   # Random alias suffix
] {
  _http post /api/setting {} {
    alias_generator: $alias_generator
    notification: $notification
    random_alias_default_domain: $random_domain
    sender_format: $sender_format
    random_alias_suffix: $random_suffix
  }
}

# Get available domains for settings
export def 'setting domains' [] {
  _http get /api/v2/setting/domains
}

# === IMPORT/EXPORT ENDPOINTS ===

# Export all user data
export def 'export data' [] {
  _http get /api/export/data
}

# Export all aliases
export def 'export aliases' [] {
  _http get /api/export/aliases
}

# === MISC ENDPOINTS ===

# Process Apple in-app purchase payment
export def 'process apple payment' [
  receiptData: string # Base64-encoded Apple receipt data
  --is-macapp         # Mark as macOS app purchase
] {
  {
    receipt_data: $receiptData
    is_macapp: $is_macapp
  }
  | _http post /api/apple/process_payment {} $in
}

# Get messages for a phone reservation
export def 'phone messages' [
  reservationId: string # ID of the phone reservation
] {
  _http get /api/phone/reservations/($reservationId)
}
