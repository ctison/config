// https://zed.dev/docs/configuring-zed
{
  "pane_split_direction_vertical": "right",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "focus_follows_mouse": {
    "enabled": false
  },
  "tab_bar": {
    "show": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "show_whitespaces": "trailing",
  "proxy": "",
  "mouse_wheel_zoom": false,
  "ui_font_size": 14.0,
  "buffer_line_height": "standard",
  "diff_view_style": "unified",
  "agent": {
    "sidebar_side": "right",
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "enable_feedback": false,
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },

  "terminal": {
    "toolbar": {
      "breadcrumbs": false
    },
    "copy_on_select": true,
    "option_as_meta": true,
    "font_size": 12.0,
    "dock": "right"
  },
  "project_panel": {
    "diagnostic_badges": true,
    "dock": "right"
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true
  },
  "title_bar": {
    "show_menus": true
  },
  "search": {
    "center_on_match": true
  },
  "colorize_brackets": true,
  "soft_wrap": "editor_width",
  "auto_indent_on_paste": false,
  "tab_size": 2,
  "cli_default_open_behavior": "new_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "icon_theme": {
    "mode": "light",
    "light": "VSCode Great Icons Theme",
    "dark": "VSCode Great Icons Theme"
  },
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "light",
    "light": "GitHub Dark",
    "dark": "GitHub Dark"
  }
}
