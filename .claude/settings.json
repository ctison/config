{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "statusMessage": "Linting...",
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-write-lint.nu"
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": ["_/.agents/AGENTS.md"]
}
