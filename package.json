{
  "name": "@ctison/root",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "_/.agents/skills/dev-react",
      "pkgs/*",
      "pkgs/_/*"
    ],
    "catalogs": {}
  },
  "scripts": {
    "ci": "nu ./scripts/ci.nu",
    "clean": "bun run -F './**' clean",
    "fmt": "nu ./scripts/fmt.nu",
    "lint": "nu ./scripts/lint.nu",
    "prepare": "husky",
    "pretest": "tsc",
    "test": "bun run -F './**' test",
    "update": "bun update -ri"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cspell": "10.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "sort-package-json": "4.0.0",
    "tombi": "1.2.4",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.0.0"
}
