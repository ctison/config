{
  "name": "@ctison/root",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "pkgs/*",
      "pkgs/_/*"
    ],
    "catalogs": {
      "react": {
        "react": "19.2.5",
        "react-dom": "19.2.5"
      }
    }
  },
  "scripts": {
    "ci": "nu ./scripts/ci.nu",
    "clean": "bun run -F './**' clean",
    "fmt": "nu ./scripts/fmt.nu",
    "lint": "nu ./scripts/lint.nu",
    "prepare": "husky",
    "pretest": "tsc",
    "test": "bun run -F './**' test",
    "update": "bun update -ri"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "cspell": "10.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "prettier-plugin-jsdoc": "1.8.1",
    "prettier-plugin-toml": "2.0.6",
    "sort-package-json": "4.0.0",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.0.0"
}
